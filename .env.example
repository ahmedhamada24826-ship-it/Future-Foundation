# ==============================================================================
# KEMIX ACADEMY — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# Production PostgreSQL Connection URL (Neon / Supabase / Vercel Postgres / Railway)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. PERSISTENT PARTNER LOGO STORAGE (Supabase Storage)
# ------------------------------------------------------------------------------
# Project URL and service role key; keep the service role key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=partner-logos

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# 32+ character random string for signing Admin JWT tokens
JWT_SECRET=

# Secret token required to trigger automated cron acceptance endpoints
CRON_SECRET=

# ------------------------------------------------------------------------------
# 4. INITIAL ADMIN SEED CREDENTIALS (Used by prisma/seed.js)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# 5. EMAIL SERVICE CREDENTIALS (Resend or SMTP)
# ------------------------------------------------------------------------------
# Resend API Key (starts with re_...)
RESEND_API_KEY=

# Sender Details
EMAIL_FROM=
EMAIL_SENDER_NAME=
PROGRAM_NAME=

# Custom SMTP Configuration (Fallback if Resend is not used)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# ------------------------------------------------------------------------------
# 6. APPLICATION URLS
# ------------------------------------------------------------------------------
APP_URL=
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------------------
# 7. YOUTUBE / LIVE LECTURE INTEGRATION (OPTIONAL / PLACEHOLDER)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_BROADCAST_TITLE_PREFIX=
YOUTUBE_LIVE_PRIVACY_STATUS=
